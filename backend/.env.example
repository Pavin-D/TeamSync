# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamsync?schema=public"

# Express Server Port
PORT=5000

# JSON Web Token Secret & Expiration
JWT_SECRET="teamsync_super_secret_jwt_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Frontend Application Origin URL
FRONTEND_URL="http://localhost:5173"

# GitHub API Credentials (For GitHub Skill Analysis)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
